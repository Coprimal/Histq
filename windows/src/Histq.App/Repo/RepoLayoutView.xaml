<?xml version="1.0" encoding="utf-8"?>
<!--
    A repo tab's three panels (ported from RepoLayoutView.swift at 6fa6d40, the Classic layout): the sidebar, the commit
    graph and the detail, cards on the page sheet with an 8 epx gap. The two gaps are draggable dividers; the side
    panels' widths (sidebar 200-420, detail 320-640, the graph at least 360) are set in RepoLayoutView.xaml.cs from the
    panelWidths preference. TabContentHost's margin is the Mac's inset around the panels. The sidebar's and the detail's
    content come in later milestones (M2+): until then they show their placeholder. The graph shows its placeholder
    (skeleton rows, a spinner fading in after SpinnerDelay) until its first rows are in, or the load's error.
-->
<UserControl
    x:Class="Histq.App.Repo.RepoLayoutView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:graph="using:Histq.App.Graph"
    xmlns:repo="using:Histq.App.Repo">
    <UserControl.Resources>
        <!-- A panel's card (SectionCard.swift): the sheet's card fill and its 1 epx edge. -->
        <Style x:Key="PanelCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SheetCardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SheetCardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
        </Style>
        <SolidColorBrush x:Key="SkeletonBrush" Color="{StaticResource SkeletonFillColor}" />
        <!-- A capsule bar of a placeholder. -->
        <Style x:Key="SkeletonBarStyle" TargetType="Border">
            <Setter Property="Height" Value="10" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Background" Value="{StaticResource SkeletonBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid x:Name="PanelsGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="252" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition x:Name="DetailColumn" Width="360" />
        </Grid.ColumnDefinitions>

        <!-- Panel 1: the sidebar (M2: branches, remotes, tags, stashes...). -->
        <repo:RepoPanel x:Name="SidebarPanel" AutomationProperties.Name="Sidebar">
            <Border Style="{StaticResource PanelCardStyle}">
                <StackPanel Padding="12,14,12,0" Spacing="12">
                    <Border Width="96" Style="{StaticResource SkeletonBarStyle}" />
                    <Border Width="150" Style="{StaticResource SkeletonBarStyle}" />
                    <Border Width="120" Style="{StaticResource SkeletonBarStyle}" />
                    <Border Width="140" Style="{StaticResource SkeletonBarStyle}" />
                    <Border Width="80" Style="{StaticResource SkeletonBarStyle}" />
                </StackPanel>
            </Border>
        </repo:RepoPanel>

        <repo:PanelDivider x:Name="SidebarDivider" Grid.Column="1" />

        <!-- Panel 2: the commit graph. -->
        <Border Grid.Column="2" Style="{StaticResource PanelCardStyle}">
            <Grid Padding="1,8,1,8">
                <graph:GraphCanvas x:Name="CommitGraph" AutomationProperties.Name="Commit graph" />
                <Grid x:Name="GraphPlaceholder" IsHitTestVisible="False">
                    <StackPanel Padding="12,6,12,0" Spacing="14">
                        <Border Width="260" Style="{StaticResource SkeletonBarStyle}" />
                        <Border Width="200" Style="{StaticResource SkeletonBarStyle}" />
                        <Border Width="300" Style="{StaticResource SkeletonBarStyle}" />
                        <Border Width="180" Style="{StaticResource SkeletonBarStyle}" />
                        <Border Width="240" Style="{StaticResource SkeletonBarStyle}" />
                        <Border Width="210" Style="{StaticResource SkeletonBarStyle}" />
                    </StackPanel>
                    <ProgressRing
                        x:Name="GraphSpinner"
                        Width="24"
                        Height="24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsActive="False"
                        Opacity="0" />
                </Grid>
                <!-- The load's error (RepoLayoutView.swift: a label with a warning sign, top leading). -->
                <Grid
                    x:Name="GraphFailure"
                    Padding="12"
                    VerticalAlignment="Top"
                    ColumnSpacing="8"
                    Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        VerticalAlignment="Top"
                        FontSize="14"
                        Glyph="&#xE7BA;"
                        Opacity="0.6" />
                    <TextBlock
                        x:Name="GraphFailureText"
                        Grid.Column="1"
                        FontSize="13"
                        IsTextSelectionEnabled="True"
                        Opacity="0.6"
                        TextWrapping="Wrap" />
                </Grid>
            </Grid>
        </Border>

        <repo:PanelDivider x:Name="DetailDivider" Grid.Column="3" />

        <!-- Panel 3: the detail (M2: the selected commit). -->
        <repo:RepoPanel
            x:Name="DetailPanel"
            Grid.Column="4"
            AutomationProperties.Name="Detail">
            <Border Style="{StaticResource PanelCardStyle}">
                <StackPanel Padding="12,14,12,0" Spacing="12">
                    <Border Width="200" Style="{StaticResource SkeletonBarStyle}" />
                    <Border Width="140" Style="{StaticResource SkeletonBarStyle}" />
                    <Border Width="240" Style="{StaticResource SkeletonBarStyle}" />
                </StackPanel>
            </Border>
        </repo:RepoPanel>
    </Grid>
</UserControl>
