<?xml version="1.0" encoding="utf-8"?>
<!--
    The title bar = tab row (layout B, design header-and-tab-row.md §1), 48 epx = TitleBarHeightOption.Tall: the logo
    (app menu), the tab strip, a free drag area and the caption buttons' inset. Only the elements Shell/TitleBarRegions
    lists take input; the rest is caption (drag, double-click maximizes, right-click system menu).
-->
<UserControl
    x:Class="Histq.App.Shell.TitleBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tabs="using:Histq.App.Shell.Tabs"
    Height="{StaticResource TitleBarHeight}">
    <UserControl.Resources>
        <!-- The logo: no capsule, hover fill white 0.10, pressed 0.20 (design §1). -->
        <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
        <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="HoverFillBrush" />
        <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="PressedFillBrush" />
        <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
    </UserControl.Resources>

    <Grid x:Name="BarGrid">
        <Grid.ColumnDefinitions>
            <!-- Inset columns sit under the caption buttons; TitleBarRegions sizes them from LeftInset/RightInset. -->
            <ColumnDefinition x:Name="LeftInsetColumn" Width="0" />
            <ColumnDefinition Width="Auto" />
            <!-- Star column: it absorbs a narrow window, so the drag column always stays on screen. -->
            <ColumnDefinition Width="*" />
            <!-- Free drag area, never narrower than 48 epx. -->
            <ColumnDefinition x:Name="DragColumn" Width="Auto" MinWidth="48" />
            <ColumnDefinition x:Name="RightInsetColumn" Width="0" />
        </Grid.ColumnDefinitions>

        <!-- The logo opens the app menu (built in code; Alt and F10 open it too): 32x32 in the tabs' 36 epx band, so
             the top 12 epx still drag. -->
        <Button
            x:Name="LogoButton"
            Grid.Column="1"
            Width="{StaticResource LogoSize}"
            Height="{StaticResource LogoSize}"
            MinWidth="0"
            MinHeight="0"
            Margin="8,0,8,2"
            Padding="0"
            VerticalAlignment="Bottom"
            AutomationProperties.Name="Histq menu"
            ToolTipService.ToolTip="Histq menu (Alt)">
            <FontIcon FontSize="16" Glyph="&#xE700;" />
            <Button.Flyout>
                <MenuFlyout x:Name="AppMenu" Placement="BottomEdgeAlignedLeft" />
            </Button.Flyout>
        </Button>

        <!-- The tab row (Shell/Tabs/TabStrip), given the whole star column: it lays its parts out from the left and
             clips what a narrow window cannot hold. Tabs are 36 epx tall on the row's bottom edge; the 12 epx above them
             always drag the window, and so does the column's space after All Tabs (only the strip's items are
             Passthrough). -->
        <Border
            x:Name="TabStripHost"
            Grid.Column="2"
            Height="{StaticResource TabHeight}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Bottom">
            <tabs:TabStrip x:Name="Strip" />
        </Border>
    </Grid>
</UserControl>
