<?xml version="1.0" encoding="utf-8"?>
<!--
    The uploaded images to pick a tab icon from (Shell/IconLibraryPicker.xaml.cs): Upload…, then the stored images
    newest first in one row. The thumbnails are made in code.
-->
<UserControl
    x:Class="Histq.App.Shell.IconLibraryPicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="8">
        <Button
            x:Name="UploadButton"
            AutomationProperties.Name="Upload image"
            Content="Upload…" />
        <Grid
            x:Name="UploadedRow"
            ColumnSpacing="8"
            Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                FontSize="12"
                Opacity="0.6"
                Text="Uploaded" />
            <ScrollViewer
                Grid.Column="1"
                HorizontalScrollBarVisibility="Hidden"
                HorizontalScrollMode="Enabled"
                VerticalScrollBarVisibility="Disabled"
                VerticalScrollMode="Disabled">
                <StackPanel
                    x:Name="Thumbnails"
                    AutomationProperties.Name="Uploaded images"
                    Orientation="Horizontal"
                    Spacing="6" />
            </ScrollViewer>
        </Grid>
    </StackPanel>
</UserControl>
