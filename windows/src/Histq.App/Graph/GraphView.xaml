<?xml version="1.0" encoding="utf-8"?>
<!--
    The commit graph with its columns (ported from GraphView.swift at 6fa6d40): the column titles (Branch / Tag, Graph,
    Commit message, Author, Time) on a 26 epx header with a hairline below, then the rows, drawn by one viewport-sized
    Win2D canvas. The titles are made in GraphView.xaml.cs (one per column, with its resize grip); a right-click on the
    header shows or hides the message, author and date columns. While branches are left out, the chip at the header's
    end says so ("2 hidden · Show All", "Solo · Show All") and shows them all (GraphVisibilityChip).
-->
<UserControl
    x:Class="Histq.App.Graph.GraphView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:graph="using:Histq.App.Graph">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="26" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="HeaderGrid" Background="Transparent">
            <Grid.ContextFlyout>
                <MenuFlyout x:Name="HeaderMenu" Opening="OnHeaderMenuOpening">
                    <ToggleMenuFlyoutItem
                        x:Name="ShowMessageItem"
                        Click="OnShowColumnClick"
                        Text="Commit Message Column" />
                    <ToggleMenuFlyoutItem
                        x:Name="ShowAuthorItem"
                        Click="OnShowColumnClick"
                        Text="Author Column" />
                    <ToggleMenuFlyoutItem
                        x:Name="ShowDateItem"
                        Click="OnShowColumnClick"
                        Text="Time Column" />
                </MenuFlyout>
            </Grid.ContextFlyout>
        </Grid>
        <Border
            Height="1"
            VerticalAlignment="Bottom"
            Background="{StaticResource GraphSeparatorBrush}"
            IsHitTestVisible="False" />

        <graph:GraphCanvas x:Name="Rows" Grid.Row="1" />

        <Button
            x:Name="VisibilityChip"
            Height="22"
            Margin="0,2,8,0"
            Padding="10,0,10,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Click="OnVisibilityChipClick"
            CornerRadius="11"
            ToolTipService.ToolTip="Show every branch in the graph"
            Visibility="Collapsed">
            <!-- The runs on one line: whitespace between inlines would show as extra spaces. -->
            <TextBlock FontSize="11"><Run x:Name="VisibilitySummary" /><Run Text=" · " /><Run Foreground="{StaticResource BrandAccentBrush}" Text="Show All" /></TextBlock>
        </Button>
    </Grid>
</UserControl>
