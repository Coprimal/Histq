<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged: no MSIX. MSIX tooling stays on only to generate resources.pri. -->
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <AssemblyName>Histq</AssemblyName>
    <RootNamespace>Histq.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Histq.ico</ApplicationIcon>
    <!-- Program.cs is the entry point; the XAML compiler must not generate a Main. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <!-- QA flags compile only in Debug or with -p:HistqQa=true. Appended here, never passed as -p:DefineConstants,
         which would replace DISABLE_XAML_GENERATED_MAIN. -->
    <DefineConstants Condition="'$(Configuration)' == 'Debug' Or '$(HistqQa)' == 'true'">$(DefineConstants);HISTQ_QA</DefineConstants>
    <!-- Never PublishTrimmed or NativeAOT: CsWin32 classic COM interop (Histq.Platform, phase 7) breaks under trimming and AOT. -->
  </PropertyGroup>

  <ItemGroup>
    <!-- WASDK component packages, not the metapackage (see Directory.Packages.props). -->
    <PackageReference Include="Microsoft.WindowsAppSDK.Base" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" />
    <PackageReference Include="Microsoft.WindowsAppSDK.DWrite" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="Microsoft.Graphics.Win2D" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Histq.Core\Histq.Core.csproj" />
  </ItemGroup>
</Project>
