<?xml version="1.0" encoding="utf-8"?>
<!--
    The detail panel's summary of the selected row (ported from the commit info card of CommitDetailPanel.swift at
    6fa6d40, its header part): the kind (Commit, Stash, Changes, Worktree), the subject and body, the author with the
    email and date, the committer when another person, the SHA, and the parents, each a link to its row. Its placeholder
    (skeleton lines in the same card, a spinner fading in after SpinnerDelay) shows in the click's frame until the
    summary is made off the UI thread.
-->
<UserControl
    x:Class="Histq.App.Detail.CommitSummaryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <SolidColorBrush x:Key="SummarySkeletonBrush" Color="{StaticResource SkeletonFillColor}" />
        <Style x:Key="SummarySkeletonStyle" TargetType="Border">
            <Setter Property="Height" Value="10" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Background" Value="{StaticResource SummarySkeletonBrush}" />
        </Style>
        <Style x:Key="SummaryLabelStyle" TargetType="TextBlock">
            <Setter Property="Width" Value="52" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource GraphSecondaryTextBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- The placeholder: the loaded card's rows as skeleton lines, the spinner over them. -->
        <Grid x:Name="Placeholder" Padding="12,14,12,12">
            <StackPanel Spacing="12">
                <Border Width="64" Style="{StaticResource SummarySkeletonStyle}" />
                <Border Width="220" Style="{StaticResource SummarySkeletonStyle}" />
                <Border Width="150" Style="{StaticResource SummarySkeletonStyle}" />
                <Border Width="200" Style="{StaticResource SummarySkeletonStyle}" />
                <Border Width="90" Style="{StaticResource SummarySkeletonStyle}" />
            </StackPanel>
            <ProgressRing
                x:Name="Spinner"
                Width="24"
                Height="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsActive="False"
                Opacity="0" />
        </Grid>

        <ScrollViewer x:Name="SummaryContent" Visibility="Collapsed">
            <StackPanel Padding="12,14,12,12" Spacing="10">
                <TextBlock
                    x:Name="KindText"
                    CharacterSpacing="57"
                    FontSize="10.5"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource GraphSecondaryTextBrush}" />
                <TextBlock
                    x:Name="SubjectText"
                    FontSize="14"
                    IsTextSelectionEnabled="True"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="BodyText"
                    FontSize="13"
                    Foreground="{StaticResource GraphSecondaryTextBrush}"
                    IsTextSelectionEnabled="True"
                    TextWrapping="Wrap" />
                <StackPanel x:Name="AuthorRow" Spacing="2">
                    <TextBlock
                        x:Name="AuthorText"
                        FontSize="13"
                        FontWeight="SemiBold"
                        IsTextSelectionEnabled="True"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:Name="AuthorDetailText"
                        FontSize="12"
                        Foreground="{StaticResource GraphSecondaryTextBrush}"
                        IsTextSelectionEnabled="True"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel x:Name="CommitterRow" Spacing="2">
                    <TextBlock
                        x:Name="CommitterText"
                        FontSize="13"
                        FontWeight="SemiBold"
                        IsTextSelectionEnabled="True"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:Name="CommitterDetailText"
                        FontSize="12"
                        Foreground="{StaticResource GraphSecondaryTextBrush}"
                        IsTextSelectionEnabled="True"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel
                    x:Name="HashRow"
                    Orientation="Horizontal"
                    Spacing="8">
                    <TextBlock Style="{StaticResource SummaryLabelStyle}" Text="SHA" />
                    <TextBlock
                        x:Name="HashText"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="SHA"
                        FontFamily="Consolas"
                        FontSize="13"
                        IsTextSelectionEnabled="True" />
                </StackPanel>
                <StackPanel
                    x:Name="ParentsRow"
                    Orientation="Horizontal"
                    Spacing="8">
                    <TextBlock x:Name="ParentsLabel" Style="{StaticResource SummaryLabelStyle}" />
                    <StackPanel
                        x:Name="ParentsPanel"
                        Orientation="Horizontal"
                        Spacing="4" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
