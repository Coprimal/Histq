<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Histq.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="using:Histq.App.Shell"
    xmlns:tabs="using:Histq.App.Shell.Tabs">
    <!-- No Background: the system backdrop shows through, except in the solid fallback (MainWindow.xaml.cs). -->
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <!-- Page sheet joined to the selected tab (design §1.2, §3.2): one figure from Shell/SheetTabShape, white at
             0.09, behind the title bar and the sheet content. Geometry in RootGrid coordinates, rebuilt in code. -->
        <Path
            x:Name="SheetPath"
            Grid.RowSpan="2"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Fill="{StaticResource SheetBrush}"
            IsHitTestVisible="False"
            Stretch="None" />

        <!-- Title bar = tab row (layout B, design header-and-tab-row.md §1): logo (app menu), tab strip, drag area,
             caption inset (Shell/TitleBar). -->
        <shell:TitleBar x:Name="AppTitleBar" />

        <!-- Vertical tabs (design §4, Shell/Tabs/VerticalTabsPanel), shown in place of the title bar's strip when the
             tab position is Left: 150 epx left of the sheet, inset 8 from the window's left; the sheet then starts at
             its trailing edge (MainWindow.xaml.cs), the selected row joined to it. -->
        <tabs:VerticalTabsPanel
            x:Name="VerticalTabs"
            Grid.Row="1"
            Margin="8,0,0,0"
            HorizontalAlignment="Left"
            Visibility="Collapsed" />

        <!-- Page sheet (SheetPath draws it, inset 8 from the window's sides; the footer row is the gap under it): the
             command bar on top, then the selected tab's content. 8 more from the sheet's sides, so the content clears
             the 22 epx corners. -->
        <Grid x:Name="SheetArea" Grid.Row="1" Margin="8,0,8,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!-- The command bar (design §1.3, Shell/CommandBar): client area, nothing in the sheet drags the window. -->
            <shell:CommandBar x:Name="AppCommandBar" />
            <shell:TabContentHost x:Name="ContentHost" Grid.Row="1" Margin="8,0,8,8" />
        </Grid>

        <!-- Footer (MainView.swift WindowFooter), 30 epx under the sheet, on the window glass: Sidebar, the selected
             repo's folder and its running operation, then the version and Detail. The toggles are off until a repo
             layout has panels (phase 13). -->
        <Grid
            x:Name="Footer"
            Grid.Row="2"
            Height="{StaticResource FooterHeight}"
            Padding="22,0,22,0"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button
                x:Name="SidebarToggle"
                Padding="6,2,6,2"
                VerticalAlignment="Center"
                AutomationProperties.Name="Hide Sidebar"
                Background="Transparent"
                BorderThickness="0"
                IsEnabled="False"
                ToolTipService.ToolTip="Hide Sidebar">
                <FontIcon FontSize="15" Glyph="&#xE90C;" />
            </Button>
            <!-- Sized to its text, so the running status follows the path; the path trims first. -->
            <Grid Grid.Column="1" HorizontalAlignment="Left" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="PathText"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Opacity="0.6"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    x:Name="RunningStatusText"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Opacity="0.6" />
            </Grid>
            <TextBlock
                x:Name="VersionText"
                Grid.Column="2"
                VerticalAlignment="Center"
                FontFamily="Cascadia Mono, Consolas"
                FontSize="12"
                Opacity="0.6" />
            <Button
                x:Name="DetailToggle"
                Grid.Column="3"
                Padding="6,2,6,2"
                VerticalAlignment="Center"
                AutomationProperties.Name="Hide Detail"
                Background="Transparent"
                BorderThickness="0"
                IsEnabled="False"
                ToolTipService.ToolTip="Hide Detail">
                <FontIcon FontSize="15" Glyph="&#xE90D;" />
            </Button>
        </Grid>

        <!-- Toasts (Shell/ToastHost) at the window's bottom right, over everything; only its cards take clicks. -->
        <shell:ToastHost
            x:Name="Toasts"
            Grid.RowSpan="3"
            Margin="16" />
    </Grid>
</Window>
